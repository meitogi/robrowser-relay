{
	"manifest_version": 3,
	"name": "roBrowser relay",
	"version": "0.3.1",
	"description": "Private beta. Hands your own game client folder (GRF + BGM) to the roBrowser game pages on robrowser.suuuper.app, and lets them call the cyro.live API directly.",
	"browser_specific_settings": {
		"gecko": {
			"id": "robrowser-relay@meitogi.github.io",
			"strict_min_version": "142.0",
			"data_collection_permissions": {
				"required": [
					"none"
				]
			}
		}
	},
	"background": {
		"scripts": [
			"db.js",
			"background.js"
		]
	},
	"action": {
		"default_title": "roBrowser relay",
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icons/icon-16.png",
			"32": "icons/icon-32.png"
		}
	},
	"permissions": [
		"unlimitedStorage",
		"webRequest",
		"webRequestBlocking"
	],
	"host_permissions": [
		"https://cyro.localhost/*",
		"https://robrowser.suuuper.app/*",
		"https://cyro.live/*"
	],
	"content_scripts": [
		{
			"matches": [
				"https://cyro.localhost/*",
				"https://robrowser.suuuper.app/*"
			],
			"js": [
				"state.js",
				"content.js"
			],
			"run_at": "document_start"
		}
	],
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"96": "icons/icon-96.png",
		"128": "icons/icon-128.png"
	},
	"homepage_url": "https://github.com/meitogi/robrowser-relay"
}
